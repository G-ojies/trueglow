# mock: realistic fixture responses shaped like the documented YouCam API (no key, no units)
# live: real calls to https://yce-api-01.makeupar.com using YOUCAM_API_KEY
YOUCAM_MODE=mock
YOUCAM_API_KEY=

# Safety cap on YouCam units this server will spend per UTC day (live mode only)
YOUCAM_DAILY_UNIT_CAP=150

# Label photo reading (optional). Groq free tier; the LLM only extracts the ingredient list.
GROQ_API_KEY=
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
